# docker compose reads this file as .env; every value below has a local default
POSTGRES_PASSWORD=payflow
JWT_SECRET=local-only-jwt-secret-change-before-deploying
ADMIN_SESSION_SECRET=local-only-admin-session-secret
PAYMENT_PROVIDER_API_KEY=local-provider-api-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=local-webhook-secret
SEED_ADMIN_PASSWORD=admin-demo-pass
SEED_USER_PASSWORD=demo-pass-123

API_PORT=8000
MOCK_PROVIDER_PORT=8001
LOCUST_PORT=8089
LOG_LEVEL=INFO
TRANSFER_RATE_LIMIT=10
MOCK_PROVIDER_CAPTURE_DELAY_SECONDS=2

# running the api or worker on the host instead of in compose
DATABASE_URL=postgresql+asyncpg://payflow:payflow@localhost:5432/payflow
REDIS_URL=redis://localhost:6379/0
PAYMENT_PROVIDER_URL=http://localhost:8001
FX_PROVIDER_URL=http://localhost:8001
LOG_JSON=false

FRAUD__LARGE_AMOUNT_KZT=1000000
FRAUD__LARGE_AMOUNT_USD=2000
FRAUD__TIMEZONE=Asia/Almaty
